#!/bin/sh
set -eu

remove_legacy_extension_policy() {
    rm -f \
        /opt/google/chrome/extensions/pflnlemikfjdffpkadjjemologkalkcl.json \
        /usr/share/google-chrome/extensions/pflnlemikfjdffpkadjjemologkalkcl.json \
        /usr/share/chromium/extensions/pflnlemikfjdffpkadjjemologkalkcl.json \
        /usr/share/brave-browser/extensions/pflnlemikfjdffpkadjjemologkalkcl.json \
        /etc/opt/chrome/policies/managed/pflnlemikfjdffpkadjjemologkalkcl.json \
        /etc/chromium/policies/managed/pflnlemikfjdffpkadjjemologkalkcl.json \
        /etc/brave/policies/managed/pflnlemikfjdffpkadjjemologkalkcl.json
}

register_brave_host() {
    uid="$1"
    entry="$(getent passwd "$uid" || true)"
    [ -n "$entry" ] || return 0

    IFS=: read -r _ _ _ gid _ home _ <<EOF
$entry
EOF
    [ -n "$home" ] && [ -d "$home" ] || return 0

    host_dir="$home/.config/BraveSoftware/Brave-Browser/NativeMessagingHosts"
    install -d -o "$uid" -g "$gid" -m 755 "$host_dir"
    manifest_tmp="$(mktemp)"
    cat > "$manifest_tmp" <<'EOF'
{
  "name": "com.vless.eevee.helper",
  "description": "vless-eevee helper",
  "path": "/opt/vless-eevee/helper",
  "type": "stdio",
  "allowed_origins": ["chrome-extension://pflnlemikfjdffpkadjjemologkalkcl/"]
}
EOF
    install -o "$uid" -g "$gid" -m 644 "$manifest_tmp" "$host_dir/com.vless.eevee.helper.json"
    rm -f "$manifest_tmp"
}

if [ "$1" = configure ]; then
    install -d -m 755 /var/lib/vless-eevee
    rm -f /var/lib/vless-eevee/vless-eevee.crx /var/lib/vless-eevee/extension-version.txt
    remove_legacy_extension_policy

    systemctl daemon-reload
    systemctl enable vless-eevee-worker.service
    systemctl restart vless-eevee-worker.service

    install_uid="${PKEXEC_UID:-}"
    if [ -z "$install_uid" ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
        install_uid="$(id -u "$SUDO_USER" 2>/dev/null || true)"
    fi

    if [ -n "$install_uid" ] && [ "$install_uid" -ge 1000 ]; then
        register_brave_host "$install_uid"
    else
        getent passwd | while IFS=: read -r _ _ uid _ _ home _; do
            if [ "$uid" -ge 1000 ] && [ -d "$home/.config/BraveSoftware/Brave-Browser" ]; then
                register_brave_host "$uid"
            fi
        done
    fi
fi

exit 0
